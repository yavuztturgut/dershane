{
  "crons": [
    {
      "path": "/api/maintenance/database-keep-alive",
      "schedule": "17 3 */2 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dershane-six.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
