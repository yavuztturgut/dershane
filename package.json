{
  "name": "dershane",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "test": "npm run test:unit && npm run test:frontend",
    "test:unit": "npm test --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "test:frontend": "npm test --workspace frontend",
    "test:frontend:utc": "node scripts/test-frontend-utc.js",
    "lint": "npm run lint --workspace frontend",
    "build": "npm run build --workspace frontend",
    "verify": "npm run test:unit && npm run test:frontend:utc && npm run lint && npm run build"
  }
}
